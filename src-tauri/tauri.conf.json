{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArkCut",
  "version": "0.17.1",
  "identifier": "local.arkcut.editor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../web-dist",
    "features": [
      "desktop"
    ]
  },
  "app": {
    "windows": [
      {
        "title": "ArkCut",
        "width": 1440,
        "height": 960,
        "minWidth": 880,
        "minHeight": 560,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; media-src 'self' asset: http://asset.localhost blob:; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
